generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// ENUMS (Strict State Machines)
// -----------------------------------------
enum Role {
  Admin
  Operator
  Driver
}

enum DriverStatus {
  Available
  OnTrip
  OffDuty
  Inactive
}

enum AssetStatus {
  Available
  OnTrip
  Maintenance
  Inactive
}

enum AssetType {
  Flatbed
  Reefer
  Box
  Tanker
}

enum TripStatus {
  Draft
  Dispatched
  AtPickup
  InTransit
  AtDelivery
  Completed
  Invoiced
  Cancelled
}

enum StopType {
  Pickup
  Dropoff
  Rest
  Refuel
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

enum DocType {
  DriverLicense
  VehicleRegistration
  Insurance
  POD
  CustomsClearance
  Waybill
  Contract
  Invoice
  Emergency
}

enum DocStatus {
  PendingReview
  Verified
  Rejected
  Expired
}

enum PaymentStatus {
  Pending
  Approved
  Paid
  Rejected
}

/// Why a stop was reached late. Logged by an operator, never by the driver:
/// drivers already report the cause in the WhatsApp group (usually with a
/// photo), and asking them to classify it in the app is training cost for
/// something the office already knows. Traffic dominates in practice.
enum DelayReason {
  Traffic
  VehicleBreakdown
  CustomerNotReady
  SlowLoadingUnloading
  Weather
  Documentation
  RouteBlocked
  Other
}

// -----------------------------------------
// 1. ORGANIZATION (Simplified)
// -----------------------------------------
model User {
  id            String  @id @default(uuid()) @db.Uuid
  username      String  @unique
  email         String? @unique
  phone         String? @unique
  password_hash String?
  name          String?
  role          Role    @default(Operator)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  verifiedDocs     Document[]     @relation("VerifiedBy")
  approvedPayments Trip[]         @relation("PaymentApprovedBy")
  driver           Driver?
  notifications    Notification[]
}

model Customer {
  id            String @id @default(uuid()) @db.Uuid
  name          String
  contact_phone String
  credit_limit  Float  @default(0)

  default_pickup_lat  Float?
  default_pickup_lng  Float?
  default_dropoff_lat Float?
  default_dropoff_lng Float?

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips     Trip[]
  invoices  Invoice[]
  rateCards RateCard[]
}

// -----------------------------------------
// 2. FLEET MANAGEMENT (Merged Vehicle/Trailer)
// -----------------------------------------
model Driver {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String?      @unique @db.Uuid
  user           User?        @relation(fields: [userId], references: [id])
  ref_id         String?      @unique
  first_name     String
  last_name      String
  phone_primary  String?      @unique
  status         DriverStatus @default(Available)
  license_number String
  license_expiry DateTime     @db.Timestamptz
  ai_risk_score  Float        @default(0.0)

  // The vehicle this driver normally drives, set from the Drivers module.
  // Trip creation pre-fills this as the trip's vehicle so dispatchers don't
  // re-pick it every time — it can still be overridden per trip.
  assignedVehicleId String?  @unique @db.Uuid
  assignedVehicle   Vehicle? @relation("DriverAssignedVehicle", fields: [assignedVehicleId], references: [id])

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips         Trip[]
  notifications Notification[]
}

model Vehicle {
  id               String      @id @default(uuid()) @db.Uuid
  ref_id           String?     @unique
  plate_number     String      @unique
  asset_type       AssetType
  status           AssetStatus @default(Available)
  capacity_kg      Int
  current_odometer Float       @default(0.0)
  gps_device_id    String?
  last_lat         Float?
  last_lng         Float?

  // Trailer Information Merged
  trailer_number      String?
  trailer_type        AssetType?
  trailer_capacity_kg Int?

  // Third-Party Tracking
  icces_device_id String? @unique

  // Latest known telemetry, overwritten by the ICCES poller. Only the current
  // position is kept — there is no history table, so this answers "where is it
  // now?" and cannot answer "where was it yesterday?".
  //
  // All nullable, and deliberately so: a vehicle with no tracker, or one whose
  // tracker has never reported, must be distinguishable from one genuinely
  // sitting still at 0 km/h. Defaulting these to 0 would invent telemetry.
  //
  // `last_seen_at` is the one that matters most operationally: it is when the
  // DEVICE reported, not when MERCON polled. Without it a tracker that died
  // four hours ago looks exactly like a truck parked four hours ago — the
  // fleet already contains such a device (DEVICE_NOT_WORKING, last report
  // 4h22m stale) so this is not hypothetical.
  last_speed_kph Float?
  last_heading   Float?
  last_status    String?
  last_seen_at   DateTime? @db.Timestamptz

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips              Trip[]
  maintenanceRecords MaintenanceRecord[]
  assignedDriver     Driver?             @relation("DriverAssignedVehicle")
}

// -----------------------------------------
// 3. LOGISTICS ENGINE (Trips & Payments)
// -----------------------------------------
model Trip {
  id         String   @id @default(uuid()) @db.Uuid
  ref_id     String?  @unique
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  driverId   String?  @db.Uuid
  driver     Driver?  @relation(fields: [driverId], references: [id])
  vehicleId  String?  @db.Uuid
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])

  // Which rate card the billing amount came from, recorded at dispatch. Without
  // it, invoicing has to re-guess the rate later — and it guessed with a
  // different rule than the wizard used, so the invoice could disagree with the
  // price the dispatcher was shown. Null means the price was typed by hand.
  rateCardId String?   @db.Uuid
  rateCard   RateCard? @relation(fields: [rateCardId], references: [id])

  status           TripStatus @default(Draft)
  planned_distance Float?

  planned_start DateTime? @db.Timestamptz
  actual_start  DateTime? @db.Timestamptz
  planned_end   DateTime? @db.Timestamptz
  actual_end    DateTime? @db.Timestamptz

  // Extra Driver Payment Workflow
  extra_driver_payment Float?
  payment_reason       String?
  payment_approved_by  String?        @db.Uuid
  payment_approver     User?          @relation("PaymentApprovedBy", fields: [payment_approved_by], references: [id])
  payment_status       PaymentStatus?
  payment_date         DateTime?      @db.Timestamptz

  // Post-Trip Financial & Ledger Fields
  waiting_labor_charges   Float   @default(0.0)
  additional_stop_charges Float   @default(0.0)
  trip_charges            Float   @default(0.0)
  billing_amount          Float?
  carrier_name            String? @default("MERCON LOGISTICS")
  is_post_trip_settled    Boolean @default(false)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  stops    TripStop[]
  invoices Invoice[]

  @@index([vehicleId, driverId])
}

model TripStop {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String    @db.Uuid
  trip             Trip      @relation(fields: [tripId], references: [id])
  stop_sequence    Int
  stop_type        StopType
  location_lat     Float
  location_lng     Float
  // What people call this place — "Khamis Sorting Center". Coordinates
  // identify a stop but cannot be read: a delay report grouped by raw lat/lng
  // has one row per pin dropped rather than one per real destination, so the
  // same site never accumulates a history. Free text, because these are the
  // customer's yards and depots, not a list we own.
  location_name    String?
  // The full postal address of this stop, as returned by the address search.
  // location_name is the short label a report groups by ("Khamis Sorting
  // Center"); this is what a driver actually needs to find the place, and what
  // gets handed to a navigation app. Kept separate because truncating the
  // address down to a label is lossy and cannot be reversed.
  location_address String?   @db.Text
  // The lane endpoint this stop belongs to ("Riyadh"), as opposed to the exact
  // yard within it that location_name/lat/lng describe. This is what makes a
  // trip's lane recoverable after the fact, and what the rate lookup keys on.
  locationId       String?   @db.Uuid
  location         Location? @relation(fields: [locationId], references: [id])
  planned_arrival  DateTime? @db.Timestamptz
  actual_arrival   DateTime? @db.Timestamptz
  // When the driver left this stop. Paired with actual_arrival this is how
  // long they were held here — the difference between "arrived late" and
  // "arrived on time but waited three hours to be unloaded", which the two
  // are indistinguishable without it. Stamped by stampStopTransition().
  actual_departure DateTime? @db.Timestamptz

  // Why this stop was late, filled in by an operator after the fact. Null on
  // a late stop means nobody has explained it yet — that is what the report's
  // "needs a reason" flag and the operator alert are driven from, so it must
  // stay distinguishable from Other.
  delay_reason    DelayReason?
  delay_note      String?      @db.Text
  delay_logged_by String?      @db.Uuid
  delay_logged_at DateTime?    @db.Timestamptz

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
}

// -----------------------------------------
// 4. ENTERPRISE DMS (Document Management)
// -----------------------------------------
model Document {
  id          String    @id @default(uuid()) @db.Uuid
  entity_type String // "Driver", "Vehicle", "Trip", "MaintenanceRecord"
  entity_id   String    @db.Uuid
  doc_type    DocType
  status      DocStatus @default(PendingReview)

  file_url  String
  mime_type String?
  checksum  String?

  issue_date  DateTime? @db.Timestamptz
  expiry_date DateTime? @db.Timestamptz

  ocr_raw_text      String? @db.Text
  ai_extracted_json Json?   @db.JsonB
  is_confidential   Boolean @default(false)

  verified_by String? @db.Uuid
  verifier    User?   @relation("VerifiedBy", fields: [verified_by], references: [id])

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)
}

// -----------------------------------------
// 5. MAINTENANCE (External Workflow)
// -----------------------------------------
model MaintenanceRecord {
  id        String  @id @default(uuid()) @db.Uuid
  ref_id    String? @unique
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  workshop_name    String
  workshop_contact String?
  maintenance_type String

  start_date       DateTime  @default(now()) @db.Timestamptz
  end_date         DateTime? @db.Timestamptz
  service_date     DateTime  @db.Timestamptz
  status           String    @default("Completed")
  work_done        String?   @db.Text
  odometer_reading Float
  cost             Float     @default(0.0)

  invoice_number   String?
  invoice_url      String?
  next_service_due DateTime? @db.Timestamptz
  remarks          String?   @db.Text

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([vehicleId, status])
  @@index([deletedAt])
}

// -----------------------------------------
// 6. FINANCIALS (Simplified Tax-Free)
// -----------------------------------------
model Invoice {
  id         String        @id @default(uuid()) @db.Uuid
  ref_id     String?       @unique
  tripId     String        @db.Uuid
  trip       Trip          @relation(fields: [tripId], references: [id])
  customerId String        @db.Uuid
  customer   Customer      @relation(fields: [customerId], references: [id])
  status     InvoiceStatus @default(Draft)

  currency     String @default("SAR")
  subtotal     Float
  total_amount Float

  due_date DateTime @db.Timestamptz

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)
}

// -----------------------------------------
// 7. PRICING & QUOTATIONS (Rate Cards)
// -----------------------------------------
// A priced lane. Origin/destination used to be free text, which meant the
// dispatcher's stop name ("Khamis Sorting Center") never matched the lane
// ("Riyadh") and the wrong price was quietly applied. The Location FKs are
// the real identity of the lane now; route_origin/route_destination are kept
// as a denormalised copy of the two location names so existing rows, exports
// and invoices keep rendering without a join.
model RateCard {
  id                String @id @default(uuid()) @db.Uuid
  name              String
  route_origin      String
  route_destination String
  base_price        Float
  currency          String @default("SAR")

  originLocationId      String?   @db.Uuid
  originLocation        Location? @relation("RateCardOrigin", fields: [originLocationId], references: [id])
  destinationLocationId String?   @db.Uuid
  destinationLocation   Location? @relation("RateCardDestination", fields: [destinationLocationId], references: [id])

  // Null customer = the standard price for this lane, used by every customer.
  // A row with a customer overrides the standard one for that customer only.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  trips Trip[]

  is_active Boolean @default(true)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  @@index([customerId, originLocationId, destinationLocationId])
}

// A place a lane starts or ends — Riyadh, Jeddah, Makkah, Madinah. Rate cards
// are priced between two of these, so they have to come from one shared list
// rather than whatever each user typed: "Madina" and "Madinah" as free text
// are two lanes that never match each other, or the rate card.
//
// slug is the lowercased, whitespace-collapsed name and carries the unique
// constraint, so the same place can't be entered twice under different casing.
// lat/lng are the default map pin for the place; a trip stop still stores its
// own exact coordinates, since "Riyadh" is a city and the dock is a point in it.
model Location {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  // Full postal address of the place, from the address search. The name is the
  // short label people pick from a dropdown ("Jeddah"); this is the verified
  // address behind it, so a stop defaulting to this place inherits something a
  // driver can actually navigate to rather than a bare pin.
  address String? @db.Text
  lat     Float?
  lng     Float?

  is_active Boolean @default(true)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  originRateCards      RateCard[] @relation("RateCardOrigin")
  destinationRateCards RateCard[] @relation("RateCardDestination")
  tripStops            TripStop[]
}

// -----------------------------------------
// 8. SYSTEM ALERTS (Notifications)
// -----------------------------------------
model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  // Recipient is either a User (web: admin/operator) or a Driver (mobile). Exactly one is set.
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])
  driverId String? @db.Uuid
  driver   Driver? @relation(fields: [driverId], references: [id])

  title       String
  message     String  @db.Text
  type        String // "Emergency", "Trip", "Document", "System"
  is_read     Boolean @default(false)
  entity_type String? // "Trip", "Driver", "Vehicle"
  entity_id   String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
}
