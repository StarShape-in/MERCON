# ─── MERCON monorepo env reference ───────────────────────────────
# Copy the relevant block into each app's own .env file.
# App-specific templates: backend/api-server/.env.example, frontend/web-dashboard/.env.example

# ── backend/api-server ──
DATABASE_URL=postgresql://user:password@localhost:5432/mercon
JWT_SECRET=change-me-in-production
PORT=4000

# ── frontend/web-dashboard (Vite: must be prefixed VITE_) ──
VITE_API_URL=http://localhost:4000
