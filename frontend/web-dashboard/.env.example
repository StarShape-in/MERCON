VITE_API_URL=https://api.mercon.sa   # Your production API URL

# Address autocomplete (Places API (New) + Geocoding API).
# Optional: without it, address search falls back to OpenStreetMap Nominatim.
# Inlined at BUILD time by Vite, so it must also be a docker-compose build arg.
# Restrict the key to the mercon.tech referrer — see docs/technical/GOOGLE_MAPS_SETUP.md
VITE_GOOGLE_MAPS_API_KEY=
